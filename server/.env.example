# ==========================================
# QualiTrust AI - Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==========================================

# Application Settings
PROJECT_NAME="QualiTrust AI"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# CORS Settings (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Supabase PostgreSQL Connection
# Obtain this from Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use port 5432 (direct) or 6543 (transaction pooler with pgbouncer/supavisor)
# Example using psycopg3: postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+psycopg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Custom JWT Authentication Settings
# Generate a secure 256-bit random string for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload and Application Limits
MAX_UPLOAD_SIZE_BYTES=52428800 # 50MB
MAX_UNCOMPRESSED_SIZE_BYTES=209715200 # 200MB
MAX_ARCHIVE_ENTRIES=2000
ALLOW_INSECURE_TARGET_URLS=false # Set to true ONLY in local tests requiring http://

# Supabase Storage Configuration (Phase 2 Intake - Placeholder only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="application-uploads"
