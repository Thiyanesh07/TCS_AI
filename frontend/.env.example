# ==============================================================================
# QUALITRUST AI — FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Do not commit real credentials or tokens to version control.
# ==============================================================================

# Backend API Base URL (FastAPI endpoints mounted under /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application Environment Mode (development | staging | production)
VITE_APP_ENV=development

# Logging and Verbosity Level (debug | info | warn | error)
VITE_LOG_LEVEL=info

# Judge Demonstration Mode (true | false)
# When true, the frontend operates completely offline with deterministic demo data.
# When false (default for production), all requests route to live backend endpoints.
VITE_DEMO_MODE=false
